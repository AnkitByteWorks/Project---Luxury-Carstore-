# ═══════════════════════════════════════════════════════════════════════════════
#  LUXURY CARSTORE — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
#  Copy this file to `.env` in the project root: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ─── SERVER ───
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ─── MYSQL DATABASE CONFIGURATION ───
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=luxury_cars_db
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_URL=jdbc:mysql://localhost:3306/luxury_cars_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# ─── JWT & SECURITY ───
# Generate a cryptographically secure 256-bit+ secret key:
# openssl rand -base64 32
JWT_SECRET=YourSuperSecretJwtSigningKeyMustBeAtLeast32BytesLongForHS256Security!
JWT_EXPIRATION=86400000

# ─── INITIAL ADMIN CREDENTIALS ───
# If set, the initial admin user will be seeded with this password.
# In production, leave empty to automatically generate a secure one-time secret.
ADMIN_DEFAULT_PASSWORD=

# ─── REDIS CACHE & DISTRIBUTED RATE LIMITING ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── MONGODB (AUDIT & TELEMETRY) ───
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/carstore_audit

# ─── MONGO EXPRESS (OPTIONAL DOCKER UI) ───
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=your_secure_mongo_express_password

# ─── APACHE KAFKA (EVENT-DRIVEN STREAMING) ───
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── TELEGRAM NOTIFICATIONS (OPTIONAL) ───
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
